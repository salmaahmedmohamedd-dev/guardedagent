# files that must NEVER be copied into the image by "COPY . ."
# secrets: the key is passed in when the container starts (env_file in docker-compose.yml), never baked in
.env
.env.*
# my local virtual environment: huge and built for my machine, the image installs its own packages
venv/
.venv/
# python and test caches
__pycache__/
*.pyc
.pytest_cache/
# git history and docker files themselves are not needed inside the image
.git/
Dockerfile
docker-compose.yml
.dockerignore